# DATABASE_URL_OR_PROJECT_ADDRESS=
# DATABASE_PUBLISHABLE_KEY=      (may reach the browser)
# DATABASE_SECRET_KEY=           (server only, never in the browser)

# Session 3: the model provider
# MODEL_API_KEY=                 (server only, never in the browser)
